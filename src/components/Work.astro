---
import WorkItem from "./WorkItem.astro";

const { class: className = "" } = Astro.props;
---

<section id="work" class={`max-w-3xl mx-auto px-8 py-20 ${className}`}>
  <div class="text-slate mb-8 text-xs font-medium tracking-widest uppercase">
    Selected Work
  </div>
  <h2
    class="text-ink mb-5 font-serif text-3xl leading-tight font-normal tracking-tight"
  >
    Things I've built and led
  </h2>
  <p class="text-slate max-w-xl leading-relaxed">
    A mix of organizational transformation, deep technical systems, and hands-on
    engineering.
  </p>

  <div class="mt-10 flex flex-col">
    <WorkItem
      title="Cross-Functional Technology Leadership"
      description="Grew from systems administrator to CTO, directly leading teams across engineering, warehouse operations, marketing, and customer service. Drove business development initiatives, vendor negotiations, and revenue growth strategy alongside technology direction."
      focus="Leadership"
    />
    <WorkItem
      title="Production Systems & Internal Tooling"
      description="Designed and built production systems in Java and Kotlin including order management workflows, automated data pipelines, and operational tooling that supported warehouse and ecommerce functions."
      focus="Engineering"
    />
    <WorkItem
      title="Enterprise Transformation & Applied AI"
      description="Led a multi-year enterprise transformation including a legacy AS400-to-cloud-ERP migration and built a multi-channel ecommerce operation from the ground up. Deployed applied AI to operational and customer-facing systems."
      focus="Leadership"
    />
    <WorkItem
      title="Gleam Language Ecosystem Contributions"
      description="Contributed the Gleam language manager to Renovate, a widely-used dependency automation tool, working across TypeScript, Rust, and Gleam. Made upstream contributions to the Gleam compiler to enable selective dependency updates, completing the full integration across multiple projects."
      focus="Open Source"
    />
    <WorkItem
      title="PCB Design & Embedded Firmware"
      description="Designed custom circuit boards from schematic through PCB layout and manufacturing. Wrote embedded C++ firmware including a hardware display driver developed from component datasheets."
      focus="Engineering"
    />
  </div>
</section>
