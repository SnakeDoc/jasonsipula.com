---
import Divider from "@components/Divider.astro";
import Layout from "@layouts/Layout.astro";
import { formatDate } from "@utils/date";

const { title, description, date } = Astro.props;

const formattedDate = formatDate(new Date(date));
---

<Layout title={`${title} - Jason Sipula`} description={description}>
  <article class="mx-auto max-w-3xl px-8 pt-16 pb-24">
    <header class="animate-fade-up animation-delay-100 mb-12">
      <a
        href="/writing"
        class="text-slate hover:text-accent mb-8 block text-xs font-medium tracking-widest uppercase no-underline transition-colors duration-300"
      >
        Writing
      </a>
      <h1
        class="text-ink mb-5 font-serif text-3xl leading-tight font-normal tracking-tight"
      >
        {title}
      </h1>
      <div class="text-slate mb-4 text-xs font-medium">
        {formattedDate}
      </div>
      <p class="text-slate max-w-xl leading-relaxed">{description}</p>
    </header>

    <Divider class="animate-fade-up animation-delay-150" />

    <div
      class="animate-fade-up animation-delay-200 prose prose-slate prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-tight prose-headings:text-ink prose-a:text-accent prose-a:no-underline prose-a:border-b prose-a:border-transparent hover:prose-a:border-accent prose-strong:text-ink prose-strong:font-normal prose-code:text-ink prose-code:before:content-none prose-code:after:content-none max-w-none pt-16"
    >
      <slot />
    </div>
  </article>
</Layout>
